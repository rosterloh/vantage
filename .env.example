# Copy to `.env` and fill in. `.env` is gitignored — never commit real credentials.
# The coordinator loads `.env` at startup (dotenvy); the real process environment
# still overrides anything set here.

# Listen address (optional; default 0.0.0.0:8080)
# VANTAGE_BIND=0.0.0.0:8080

# Log level (optional)
# RUST_LOG=info

# --- OpenTelemetry (optional) ---
# Set an OTLP/gRPC endpoint to export logs, metrics, and traces to Grafana (via
# Alloy, the OpenTelemetry Collector, or a Grafana Cloud OTLP endpoint). Leave
# unset to keep plain stderr logging with no export. Applies to all three
# binaries (coordinator, robot, client).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Extra OTLP headers, e.g. Grafana Cloud auth (base64 "instanceID:token"):
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64>
# Override the reported service.name (defaults to vantage-<binary>):
# OTEL_SERVICE_NAME=vantage-robot

# --- TURN (metered.ca account static credentials, or self-hosted coturn) ---
# Use ONE plain `turn:` URL (NOT `turns:` — TLS is not yet supported, see
# docs/turn-setup.md). Username/credential are the static pair from your metered
# dashboard, or the user you configured in coturn.
VANTAGE_TURN_URL=turn:standard.relay.metered.ca:443
VANTAGE_TURN_USER=your-metered-username
VANTAGE_TURN_PASS=your-metered-credential

# --- Coordinator auth (strongly recommended) ---
# Shared bearer token. When set, every coordinator route except /healthz requires
# `Authorization: Bearer <token>`; when unset the coordinator WARNS and runs open.
# The robot and client read the SAME variable from their process environment and
# present it on the WS handshake and the /ice fetch.
# Generate one with: openssl rand -hex 32
# VANTAGE_COORDINATOR_TOKEN=

# TURN credential rotation: the static credentials below were previously served
# by the unauthenticated /ice endpoint — treat any credentials that ever sat in a
# working-tree .env as compromised and rotate them (metered.ca dashboard / coturn
# config) when enabling auth. Later hardening option (not implemented): ephemeral
# time-limited TURN credentials (TURN REST API HMAC, coturn `use-auth-secret`).
